# Template for local configuration.
# Run infra/init-env.sh to create .env (git-ignored) from this file with the MongoDB passwords generated,
# or copy it to .env and fill in the values by hand. Never commit .env.

# LLM used by the Camunda AI Agent connector (OpenAI-compatible endpoint), see ADR 0017
# Development default: Groq, LLM_BASE_URL=https://api.groq.com/openai/v1, LLM_MODEL=openai/gpt-oss-120b
# Optional until the agent process exists: nothing calls the LLM yet.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# Embeddings for RAG
VOYAGE_API_KEY=

# Password of the `mongot` MongoDB user (searchCoordinator role), used only inside the Compose network.
# Any local value works; infra/init-env.sh generates one, or by hand: openssl rand -hex 16
MONGOT_PASSWORD=

# MongoDB users, created by the mongodb-init service. Local-only values, not linked to any external account.
# infra/init-env.sh generates them, or by hand: openssl rand -hex 16
# Administrator (root role), used only by mongodb-init. Cannot change once the MongoDB data volume exists.
MONGODB_ADMIN_PASSWORD=
# Application user `provisio` (readWrite on the provisio database), used by the orchestrator.
MONGODB_APP_PASSWORD=

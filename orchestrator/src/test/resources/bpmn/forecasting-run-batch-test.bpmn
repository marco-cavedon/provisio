<?xml version="1.0" encoding="UTF-8"?>
<!-- Test process for RunForecastBatchWorkerProcessTests: start, one service task of type provisio.forecasting.run-batch
     with no input or output mappings, end. Not a product process: the forecast batch process (timer and message start
     events, ADR 0025) is modelled separately. -->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_forecasting_run_batch_test" targetNamespace="http://bpmn.io/schema/bpmn" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.9.0">
  <bpmn:process id="forecasting-run-batch-test" name="forecasting-run-batch-test" isExecutable="true">
    <bpmn:extensionElements>
      <zeebe:versionTag value="1.0" />
    </bpmn:extensionElements>
    <bpmn:startEvent id="StartEvent_1">
      <bpmn:outgoing>Flow_start_to_batch</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="RunBatch" name="provisio.forecasting.run-batch">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="provisio.forecasting.run-batch" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_start_to_batch</bpmn:incoming>
      <bpmn:outgoing>Flow_batch_to_end</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent_1">
      <bpmn:incoming>Flow_batch_to_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_start_to_batch" sourceRef="StartEvent_1" targetRef="RunBatch" />
    <bpmn:sequenceFlow id="Flow_batch_to_end" sourceRef="RunBatch" targetRef="EndEvent_1" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="forecasting-run-batch-test">
      <bpmndi:BPMNShape id="StartEvent_1_di" bpmnElement="StartEvent_1">
        <dc:Bounds x="182" y="102" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="RunBatch_di" bpmnElement="RunBatch">
        <dc:Bounds x="370" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_1_di" bpmnElement="EndEvent_1">
        <dc:Bounds x="602" y="102" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_start_to_batch_di" bpmnElement="Flow_start_to_batch">
        <di:waypoint x="218" y="120" />
        <di:waypoint x="370" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_batch_to_end_di" bpmnElement="Flow_batch_to_end">
        <di:waypoint x="470" y="120" />
        <di:waypoint x="602" y="120" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>

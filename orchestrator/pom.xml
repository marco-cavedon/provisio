<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- Same Spring Boot version Camunda 8.9.23 and Spring Modulith 2.0.8 are built against -->
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.2</version>
    <relativePath/>
  </parent>

  <groupId>io.github.marcocavedon.provisio</groupId>
  <artifactId>provisio-orchestrator</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <name>Provisio orchestrator</name>
  <description>Agent tools (Camunda job workers) and backend-for-frontend for Provisio</description>

  <properties>
    <java.version>21</java.version>
    <!-- Client version matches the orchestration cluster version (see infra) -->
    <camunda.version>8.9.23</camunda.version>
    <spring-modulith.version>2.1.2</spring-modulith.version>
    <!-- Generates the forecasting service client from contracts/forecasting/openapi.yaml at build time (ADR 0030) -->
    <openapi-generator.version>7.27.0</openapi-generator.version>

    <!--
      Dependency alignment overrides. Re-check on every Camunda or Spring Boot upgrade.
      Camunda client 8.9.23 is compiled against Apache HttpClient 5.6.4 / HttpCore 5.4.4, while Spring Boot 4.0.8
      manages 5.5.2 / 5.3.6. Without these overrides the client fails at startup with NoSuchMethodError
      (found in spike 001).
    -->
    <httpclient5.version>5.6.4</httpclient5.version>
    <httpcore5.version>5.4.4</httpcore5.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.modulith</groupId>
        <artifactId>spring-modulith-bom</artifactId>
        <version>${spring-modulith.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>io.camunda</groupId>
      <artifactId>camunda-spring-boot-starter</artifactId>
      <version>${camunda.version}</version>
    </dependency>
    <dependency>
      <groupId>org.springframework.modulith</groupId>
      <artifactId>spring-modulith-starter-core</artifactId>
    </dependency>
    <!-- MongoDB through Spring Data; the orchestrator is the only writer (ADR 0006, ADR 0022) -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-mongodb</artifactId>
    </dependency>
    <!-- RestClient and Jackson 3, used by the generated forecasting client (ADR 0030) -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-restclient</artifactId>
    </dependency>
    <!-- @Generated on the generated client classes; version managed by the Spring Boot BOM -->
    <dependency>
      <groupId>jakarta.annotation</groupId>
      <artifactId>jakarta.annotation-api</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.modulith</groupId>
      <artifactId>spring-modulith-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Integration tests against a real MongoDB in Docker; versions managed by the Spring Boot BOM -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-testcontainers</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-mongodb</artifactId>
      <scope>test</scope>
    </dependency>
    <!--
      Process tests: a real Camunda engine in Docker runs the BPMN and invokes the real job workers (ADR 0014).
      Apache 2.0 (inherited from its parent, camunda-testing). Same version as the client; built against Spring Boot 4.
    -->
    <dependency>
      <groupId>io.camunda</groupId>
      <artifactId>camunda-process-test-spring</artifactId>
      <version>${camunda.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <resources>
      <!-- Declaring resources replaces Maven's default, so src/main/resources is listed again -->
      <resource>
        <directory>src/main/resources</directory>
      </resource>
      <!-- Process models live in the top-level processes/ folder (ADR 0009) and are deployed by the application at
           startup (ProcessDeploymentConfiguration): on the classpath under processes/, without the README -->
      <resource>
        <directory>${project.basedir}/../processes</directory>
        <targetPath>processes</targetPath>
        <includes>
          <include>*.bpmn</include>
          <include>*.dmn</include>
        </includes>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
      <!--
        Java client of the forecasting service, generated from the contract on every build and never committed
        (ADR 0028, ADR 0030). It lands in an internal package of the forecasting module, so no other module sees it.
        The contract is outside this folder: the Docker build passes it as a named build context (Dockerfile).
      -->
      <plugin>
        <groupId>org.openapitools</groupId>
        <artifactId>openapi-generator-maven-plugin</artifactId>
        <version>${openapi-generator.version}</version>
        <executions>
          <execution>
            <id>forecasting-client</id>
            <goals>
              <goal>generate</goal>
            </goals>
            <configuration>
              <inputSpec>${project.basedir}/../contracts/forecasting/openapi.yaml</inputSpec>
              <generatorName>java</generatorName>
              <library>restclient</library>
              <packageName>io.github.marcocavedon.provisio.forecasting.internal.client</packageName>
              <invokerPackage>io.github.marcocavedon.provisio.forecasting.internal.client</invokerPackage>
              <apiPackage>io.github.marcocavedon.provisio.forecasting.internal.client.api</apiPackage>
              <modelPackage>io.github.marcocavedon.provisio.forecasting.internal.client.model</modelPackage>
              <generateApiTests>false</generateApiTests>
              <generateModelTests>false</generateModelTests>
              <generateApiDocumentation>false</generateApiDocumentation>
              <generateModelDocumentation>false</generateModelDocumentation>
              <configOptions>
                <!-- Spring Framework 7 RestClient and Jackson 3, as in the application -->
                <useSpringBoot4>true</useSpringBoot4>
                <useJackson3>true</useJackson3>
                <useJakartaEe>true</useJakartaEe>
                <!-- The contract has no nullable fields: no jackson-databind-nullable dependency -->
                <openApiNullable>false</openApiNullable>
                <!-- JSpecify comes with Spring Framework 7 -->
                <useJspecify>true</useJspecify>
                <annotationLibrary>none</annotationLibrary>
                <documentationProvider>none</documentationProvider>
                <dateLibrary>java8</dateLibrary>
                <hideGenerationTimestamp>true</hideGenerationTimestamp>
              </configOptions>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <!-- Fail fast with a clear message instead of cryptic class-file errors (found in spike 001) -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>enforce-build-environment</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <requireJavaVersion>
                  <version>[21,)</version>
                  <message>Provisio requires JDK 21 or later. Run 'mise install' in the repository root, or point JAVA_HOME to a JDK 21.</message>
                </requireJavaVersion>
                <requireMavenVersion>
                  <version>[3.9,)</version>
                  <message>Use the Maven Wrapper: ./mvnw</message>
                </requireMavenVersion>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>

    <bpmn:serviceTask id="Activity_0reef1p" name="Get business date">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="provisio.time.get-business-date" />
        <zeebe:ioMapping>
          <zeebe:output source="=businessDate" target="asOf" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_start_to_batch</bpmn:incoming>
      <bpmn:outgoing>Flow_19ogvke</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:startEvent id="StartEvent_1" name="scheduled start">
      <bpmn:outgoing>Flow_start_to_batch</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_10ncj2b">
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">0 0 1 * * *</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>
    <bpmn:businessRuleTask id="Activity_0i2xze8" name="Assess forecast run">
      <bpmn:extensionElements>
        <zeebe:calledDecision decisionId="provisio-forecast-run-assessment" resultVariable="forecastRunAssessment" bindingType="deployment" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_batch_to_end</bpmn:incoming>
      <bpmn:outgoing>Flow_0dq53gr</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:sequenceFlow id="Flow_0dq53gr" sourceRef="Activity_0i2xze8" targetRef="Gateway_0jk64x3" />
    <bpmn:exclusiveGateway id="Gateway_0jk64x3" name="Forecast run usable?" default="Flow_1o04j6m">
      <bpmn:incoming>Flow_0dq53gr</bpmn:incoming>
      <bpmn:outgoing>Flow_0xfaoj2</bpmn:outgoing>
      <bpmn:outgoing>Flow_0nm1ic6</bpmn:outgoing>
      <bpmn:outgoing>Flow_1o04j6m</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_0xfaoj2" name="healthy" sourceRef="Gateway_0jk64x3" targetRef="EndEvent_1">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=forecastRunAssessment.outcome = "healthy"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:endEvent id="Event_0i2fky8" name="Forecasts degraded">
      <bpmn:incoming>Flow_0nm1ic6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_0nm1ic6" name="degraded" sourceRef="Gateway_0jk64x3" targetRef="Event_0i2fky8">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=forecastRunAssessment.outcome = "degraded"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:endEvent id="Event_13u7wyo" name="Forecasts unusable">
      <bpmn:incoming>Flow_1o04j6m</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1o04j6m" sourceRef="Gateway_0jk64x3" targetRef="Event_13u7wyo" />
  </bpmn:process>

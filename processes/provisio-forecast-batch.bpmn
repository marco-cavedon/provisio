  <bpmn:process id="provisio-forecast-batch" name="Forecast batch" isExecutable="true">
    <bpmn:extensionElements>
      <zeebe:versionTag value="1.0" />
    </bpmn:extensionElements>
    <bpmn:serviceTask id="RunBatch" name="Run forecast batch">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="provisio.forecasting.run-batch" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0g7yc26</bpmn:incoming>
      <bpmn:outgoing>Flow_batch_to_end</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent_1" name="Forecasts available">
      <bpmn:incoming>Flow_0xfaoj2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_start_to_batch" sourceRef="StartEvent_1" targetRef="Activity_0reef1p" />
    <bpmn:sequenceFlow id="Flow_batch_to_end" sourceRef="RunBatch" targetRef="Activity_0i2xze8" />
    <bpmn:sequenceFlow id="Flow_0c2bgrh" sourceRef="Activity_0h1a5m0" targetRef="Gateway_0fd0e9t" />
    <bpmn:serviceTask id="Activity_0h1a5m0" name="Find completed run">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="provisio.forecasting.find-completed-run" />
        <zeebe:ioMapping>
          <zeebe:input source="=asOf" target="asOf" />
          <zeebe:output source="=completedRun" target="completedRun" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_19ogvke</bpmn:incoming>
      <bpmn:outgoing>Flow_0c2bgrh</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_0fd0e9t" name="Already forecast for asOf?" default="Flow_0a1j3p6">
      <bpmn:extensionElements />
      <bpmn:incoming>Flow_0c2bgrh</bpmn:incoming>
      <bpmn:outgoing>Flow_0a1j3p6</bpmn:outgoing>
      <bpmn:outgoing>Flow_05g4n8j</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_0a1j3p6" name="NO" sourceRef="Gateway_0fd0e9t" targetRef="Gateway_0q8jbuz" />
    <bpmn:endEvent id="Event_1mtca9y" name="Already forecast">
      <bpmn:incoming>Flow_05g4n8j</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_05g4n8j" name="YES" sourceRef="Gateway_0fd0e9t" targetRef="Event_1mtca9y">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=completedRun.found = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:startEvent id="Event_0snzlul" name="manual start">
      <bpmn:extensionElements />
      <bpmn:outgoing>Flow_1x0ftw5</bpmn:outgoing>
